/**
 * Wrangler config: https://developers.cloudflare.com/workers/wrangler/configuration/
 * Secrets (MUBIT_API_KEY) live in .dev.vars locally and `wrangler secret put` in production.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "brief-builder",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/server.ts",
	"observability": { "enabled": true },
	"upload_source_maps": true,
	// One live room per stylist: their DMs, briefs and corrections, and the screens' WebSockets.
	"durable_objects": {
		"bindings": [{ "name": "ROOMS", "class_name": "StylistRoom" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["StylistRoom"] }]
}
